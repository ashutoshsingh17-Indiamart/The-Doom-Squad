export type Product={id:string;name:string;icon:string;unit:string;specs:{key:string;options:string[]}[]};
export type Persona={id:string;name:string;city:string;gender:string;kind:string;voice:string;agentVoice:string;productId:string;description:string;language:string;intent:boolean;quantity:string;values:string[];challenge:string;aSuccess:boolean};
export type Call={id:string;key:string;personaId:string;variant:string;phase?:string;persona:Persona;product:Product;turns:{speaker:string;text:string}[];eligible:boolean;answered:boolean;success:boolean;capture:number;disposition:string;duration:number;guardrails:string[];audio:string;audioReady:boolean;extracted:Record<string,string>;explanation:string;evaluation:{model:string;at:string;source:string;evidence:Record<string,string>}|null};
export type Stats={count:number;eligible:number;answered:number;leads:number;goals:number;recovery:number;capture:number;duration:number;violations:number;dispositions:Record<string,number>};
export type Evidence={p:number;sufficient:boolean;significant:boolean;lift:number;aCount:number;bCount:number;aGoals:number;bGoals:number};
export type Decision=Evidence&{action:string;allocation:number;title:string;reason:string;aRate:number;bRate:number;aCount:number;bCount:number};
export type GoalSelection=string|string[];
export type RolloutOptions={rampUp:boolean;reduceOnDrop:boolean;protectCapture:boolean;rampStep:number;evidence:string};
export const buyerGoals:{id:string;name:string;description:string;short:string}[];
export const defaultGoals:string[];
export const defaultRollout:RolloutOptions;
export function callMeetsGoal(call:Call,id:string):boolean;
export function callMeetsGoals(call:Call,goals:GoalSelection):boolean;
export function goalLabel(goals:GoalSelection):string;
export const products:Product[];
export const personas:Persona[];
export const dispositions:string[];
export const baselinePrompt:string;
export const improvedPrompt:string;
export function scriptedCall(personaId:string,variant:string,scenario?:string):Call&{expected:{disposition:string;fields:Record<string,string>;guardrails:string[]}};
export function fixture(personaId:string,variant:string,scenario?:string):Call;
export function aggregate(calls:Call[],variant?:string,goal?:GoalSelection):Stats;
export function decide(calls:Call[],allocation:number,maxAllocation?:number,automatic?:boolean,goal?:GoalSelection,final?:boolean,options?:Partial<RolloutOptions>&{adaptiveAt30?:boolean;retainTraffic?:boolean}):Decision;
export function batchPlan(round:number,allocation:number,scenario:string,seed?:number):Call[];
export function significance(calls:Call[],goal?:GoalSelection):Evidence;
export function fisherExact(aWins:number,aTotal:number,bWins:number,bTotal:number):number;
export function shuffledCohort(seed?:number):string[];
